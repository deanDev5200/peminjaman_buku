# Copy this file to .env.local for local development
# Useful for changing the Next.js dev server port without editing code

PORT=3000
HOST=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
# Optional: absolute path to the SQLite database file.
# When unset, the app uses src/database/library.db.
# DB_PATH=C:/peminjaman_buku_data/library.db
AUTH_SECRET=dev-library-auth-secret-change-me
APP_PASSWORD=library123
DEVELOPER_ACCESS_KEY=change-this-developer-key
