# Copy this file to .env.production for production runtime overrides
# This affects `npm run start` and `npm run start:standalone`

PORT=4000
HOST=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
# Absolute path to the SQLite database file. Keeps data outside the
# deployed code folder so redeploys never overwrite it.
DB_PATH=C:/peminjaman_buku_data/library.db
AUTH_SECRET=replace-with-a-strong-secret
APP_PASSWORD=replace-with-strong-password
DEVELOPER_ACCESS_KEY=replace-with-strong-developer-key
